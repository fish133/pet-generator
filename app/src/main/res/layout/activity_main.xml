<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/background">

    <ImageView
        android:id="@+id/ivPetPreview"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pet_stopped"
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="@string/start_pet"
        android:textSize="18sp"
        app:cornerRadius="28dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUploadGif"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:text="上传 GIF 表情包"
        android:textSize="16sp"
        app:cornerRadius="26dp"
        app:backgroundTint="#4CAF50"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GIF 帧数"
        android:textSize="13sp"
        android:textColor="@color/text"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/rgFrameCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:padding="4dp">

        <RadioButton
            android:id="@+id/rb12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12帧"
            android:textSize="13sp"
            android:layout_marginEnd="20dp" />

        <RadioButton
            android:id="@+id/rb15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15帧"
            android:textSize="13sp"
            android:checked="true"
            android:layout_marginEnd="20dp" />

        <RadioButton
            android:id="@+id/rb30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30帧"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvGifCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已上传 0 个 GIF"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="桌宠大小"
        android:textSize="14sp"
        android:textColor="@color/text"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSizeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="180dp"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/sbSize"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:max="720"
        android:progress="200"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击桌宠切换表情 · 长按打开菜单"
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自定义气泡文案（每行一句）"
        android:textSize="14sp"
        android:textColor="@color/text"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etBubbleTexts"
        android:layout_width="260dp"
        android:layout_height="120dp"
        android:hint="你好呀&#10;今天也要加油哦&#10;摸摸~"
        android:textSize="14sp"
        android:textColor="@color/text"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@drawable/bubble_bg"
        android:inputType="textMultiLine|textCapSentences"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveBubble"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="确定"
        android:textSize="16sp"
        app:cornerRadius="24dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/swClickSound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="连续点击音效"
        android:textSize="14sp"
        android:textColor="@color/text"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgSoundChoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:padding="4dp">

        <RadioButton
            android:id="@+id/rbDuck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="鸭子音效"
            android:textSize="13sp"
            android:checked="true"
            android:layout_marginEnd="20dp" />

        <RadioButton
            android:id="@+id/rbBingbing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="冰冰冰音效"
            android:textSize="13sp" />
    </RadioGroup>

    </LinearLayout>
</ScrollView>
